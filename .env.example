# Public URL used for Stripe success and cancellation redirects.
# Local: http://localhost:8080  (docker-server)  or  http://127.0.0.1:5173 (vite dev)
# Production (set in Netlify): https://bucuriedigital.com
PUBLIC_BASE_URL=http://localhost:8080

# Stripe. Use sk_test_ / whsec_ keys locally; sk_live_ only in Netlify.
# STRIPE_WEBHOOK_SECRET for local testing comes from `stripe listen` (see DEPLOYMENT.md).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: forward raw leads to a CRM/spreadsheet as well as the agent pipeline.
# LEAD_WEBHOOK_URL=https://your-crm-or-lead-webhook

# ---------------------------------------------------------------------------
# Agent operating system  (see DEPLOYMENT.md -> "Agent operating system")
# ---------------------------------------------------------------------------

# Where the website sends generated tasks. Point it at the intake function on
# this same site, and set the matching shared secret below.
AGENT_WEBHOOK_URL=https://bucuriedigital.com/.netlify/functions/agent-intake
AGENT_INTAKE_SECRET=            # long random string; the site sends it, agent-intake checks it

# off | dry-run | review | live
#   off      tasks are logged, not processed
#   dry-run  agents run; outputs go to the audit log; NOTHING is sent
#   review   agents draft; you approve each outbound email in /admin
#   live     agents send lead replies + onboarding emails autonomously (guardrails still apply)
AGENT_MODE=dry-run

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5      # or claude-sonnet-5 for faster/cheaper runs
AGENT_EFFORT=low               # low | medium | high  (higher = slower, may hit the schedule timeout)

ADMIN_TOKEN=                   # >=16 chars, random; unlocks /admin
AGENT_OPERATOR_EMAIL=          # BCC'd on every agent email; gets guardrail/failure alerts in the audit log

# Rate limits / signature (optional overrides)
# AGENT_MAX_EMAILS_PER_HOUR=15
# AGENT_MIN_RECIPIENT_GAP_HOURS=6
# AGENT_EMAIL_SIGNATURE=Bucurie Digital\nhttps://bucuriedigital.com\ncontact@bucuriedigital.com

# Gmail send (run `npm run gmail:auth` once to get the refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=you@gmail.com

# Who receives "new enquiry" / "paid order" emails (falls back to AGENT_OPERATOR_EMAIL).
# OWNER_NOTIFY_EMAIL=you@example.com
# Max contact-form submissions per visitor per hour (default 5).
# CONTACT_MAX_PER_HOUR=5
